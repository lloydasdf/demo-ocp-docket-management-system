NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key for protected API routes.
# Never prefix this with NEXT_PUBLIC_.
# Never commit the real key to the repository.
# Configure the real value in Vercel deployment environment variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Google OAuth credentials and the "DOCKET FILES" root folder ID.
# Never prefix these variables with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_DOCKET_ROOT_FOLDER_ID=
